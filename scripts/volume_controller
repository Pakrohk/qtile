#!/bin/bash

# Get the action from the first argument
action="$1"

# Get the amount from the second argument, if provided
amount="${2:-5}"

# Check if a notification id exists
if [ -f /tmp/volume_notification_id ]; then
	notification_id=$(cat /tmp/volume_notification_id)
else
	notification_id=""
fi

# Function to get current volume
get_volume() {
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        # wpctl output example: "Volume: 0.45"
        wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100)}'
    else
        amixer get Master | awk 'flag==1{exit} /%/ {print $5; flag=1}' | tr -d '[]%'
    fi
}

# Function to check if muted
is_muted() {
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q "MUTED"
    else
        amixer get Master | grep -q "\[off\]"
    fi
}

# Function to notify
notify_vol() {
    local msg="$1"
    local vol=$(get_volume)
    notification_id=$(dunstify -u low -t 3000 -r 9991 'Volume' "$msg $vol%")
    echo "$notification_id" >/tmp/volume_notification_id
}

case "$action" in
"-u")
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "$(awk "BEGIN {print $amount/100}")"+
    else
        amixer set Master "${amount}%+"
    fi
    notify_vol "Increased to"
	;;
"-d")
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "$(awk "BEGIN {print $amount/100}")"-
    else
        amixer set Master "${amount}%-"
    fi
    notify_vol "Decreased to"
	;;
"-s")
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "$(awk "BEGIN {print $amount/100}")"
    else
        amixer set Master "${amount}%"
    fi
    notify_vol "Set to"
	;;
"-t")
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    else
        amixer set Master toggle
    fi

    if is_muted; then
		notification_id=$(dunstify -u low -t 3000 -r 9991 'Volume' 'Muted')
		echo "$notification_id" >/tmp/volume_notification_id
	else
        notify_vol "Unmuted,"
	fi
	;;
*)
	echo "Usage: volume_controller [-u | -d | -s | -t] [amount]"
	echo "-u: Increase volume by [amount] (default: 5)"
	echo "-d: Decrease volume by [amount] (default: 5)"
	echo "-s: Set volume to [amount]"
	echo "-t: Toggle mute/unmute"
	;;
esac
